{
  "codeLens": {
    "enable": false
  },
  "completion": {
    "baseFunctionIncludesName": false
  },
  "diagnostics": {
    "disable": [
      "unnecessary-if",
      "unnecessary-assert",
      "unresolved-require"
    ],
    "enables": [
      "incomplete-signature-doc",
      "missing-global-doc"
    ]
  },
  "documentColor": {
    "enable": false
  },
  "hint": {
    "enable": true,
    "localHint": true,
    "overrideHint": true,
    "paramHint": true
  },
  "references": {
    "fuzzySearch": false
  },
  "runtime": {
    "version": "Lua5.4"
  },
  "strict": {
    "arrayIndex": false,
    "docBaseConstMatchBaseType": true,
    "metaOverrideFileDefine": true,
    "requirePath": true
  },
  "workspace": {
    "enableReindex": true,
    "packages": [],
    "reindexDuration": 5000
  }
}